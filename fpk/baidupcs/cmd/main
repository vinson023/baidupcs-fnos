#!/bin/bash
# BaiduPCS-Rust for fnOS - lifecycle controller.
# The script runs privileged (root) so it can drop the service to a NAS user that
# is allowed to write into user volumes; the service itself never runs as root.
set -u

APPNAME="${TRIM_APPNAME:-baidupcs}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APPNAME}/target}"
ETC_DIR="${TRIM_PKGETC:-/var/apps/${APPNAME}/etc}"
VAR_DIR="${TRIM_PKGVAR:-/var/apps/${APPNAME}/var}"
TMP_DIR="${TRIM_PKGTMP:-/var/apps/${APPNAME}/tmp}"

BIN="${APP_DIR}/bin/baidu-netdisk-rust"
# BaiduPCS resolves config/app.toml, logs/ and wal/ relative to the working
# directory, so the service runs with CWD set to the app data dir. Everything it
# writes at runtime therefore lands in @appdata and survives upgrades.
RUNDIR="$VAR_DIR"
CONF="${RUNDIR}/config/app.toml"
ETC_CONF="${ETC_DIR}/app.toml"
CONF_MARK="${ETC_DIR}/.fnos-defaults-version"
RUN_CONF="${ETC_DIR}/run.conf"
LOG="${VAR_DIR}/app.log"
PID_FILE="${VAR_DIR}/app.pid"

DEFAULT_PORT="18888"
WEB_PORT="$DEFAULT_PORT"
RUN_USER="admin"
DOWNLOAD_DIR=""
DATA_VERSION="2"

mkdir -p "$ETC_DIR" "$VAR_DIR" "$TMP_DIR" 2>/dev/null

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> "$LOG" 2>/dev/null; }
fail() {
    echo "$*" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    log "ERROR: $*"
    exit 1
}

# ---------- identity ----------
# /vol* is mounted with fnOS's ACL layer: only the directory owner (a NAS user)
# reliably gets write access. Running the engine as a NAS user is therefore the
# supported way for a downloader to write into user folders.
resolve_identity() {
    if [ -n "$RUN_USER" ] && id -u "$RUN_USER" >/dev/null 2>&1; then
        RUN_UID="$(id -u "$RUN_USER")"
        RUN_GID="$(id -g "$RUN_USER")"
    elif [ -n "${TRIM_USERNAME:-}" ] && id -u "$TRIM_USERNAME" >/dev/null 2>&1; then
        RUN_USER="$TRIM_USERNAME"
        RUN_UID="$(id -u "$RUN_USER")"
        RUN_GID="$(id -g "$RUN_USER")"
    else
        RUN_USER="root"; RUN_UID=0; RUN_GID=0
    fi
}

# ---------- shares ----------
share_root() {
    local p="${TRIM_DATA_SHARE_PATHS:-}"
    p="${p%%:*}"
    if [ -z "$p" ]; then
        local vol
        vol="$(dirname "$(dirname "$(readlink -f "$ETC_DIR" 2>/dev/null || printf '%s' "$ETC_DIR")")")"
        p="${vol}/@appshare/${APPNAME}/downloads"
    fi
    printf '%s' "$p"
}

accessible_paths() {
    printf '%s' "${TRIM_DATA_ACCESSIBLE_PATHS:-}"
}

merge_wizard() {
    [ -n "${wizard_run_user:-}" ]     && RUN_USER="$wizard_run_user"
    [ -n "${wizard_download_dir:-}" ] && DOWNLOAD_DIR="$wizard_download_dir"
    return 0
}

ensure_dirs() {
    mkdir -p "$VAR_DIR/logs" "$VAR_DIR/wal" "$VAR_DIR/tmp" "$VAR_DIR/config" "$ETC_DIR" 2>/dev/null
    local dl
    dl="$(resolve_download_dir)"
    [ -n "$dl" ] && mkdir -p "$dl" 2>/dev/null
    if [ "$(id -u)" -eq 0 ] && [ "${RUN_UID:-0}" -ne 0 ]; then
        chown -R "${RUN_UID}:${RUN_GID}" "$VAR_DIR" 2>/dev/null || true
        chown "${RUN_UID}:${RUN_GID}" "$ETC_DIR" 2>/dev/null || true
        # The declared app share is created owned by the package user, which the
        # service user cannot write into. Hand it over so downloads can land there.
        local share owner
        share="$(share_root)"
        if [ -n "$share" ] && [ -d "$share" ]; then
            chown "${RUN_UID}:${RUN_GID}" "$share" 2>/dev/null || true
            chmod 775 "$share" 2>/dev/null || true
        fi
        # A download directory picked in the wizard may have been created by this
        # root script; hand it over, but never touch a folder a NAS user owns.
        if [ -n "$dl" ] && [ -d "$dl" ]; then
            owner="$(stat -c %u "$dl" 2>/dev/null || echo 0)"
            if [ "$owner" = "0" ]; then
                chown "${RUN_UID}:${RUN_GID}" "$dl" 2>/dev/null || true
            fi
        fi
    fi
}

# Expose the generated config at the conventional @appconf location as well, and
# clean up links a previous package revision may have dropped into the app dir.
link_paths() {
    [ -d "$APP_DIR" ] || fail "应用目录不存在：${APP_DIR}"
    mkdir -p "$VAR_DIR/config" 2>/dev/null
    ln -sfn "$CONF" "$ETC_CONF" 2>/dev/null
    rm -f "$APP_DIR/logs" "$APP_DIR/wal" 2>/dev/null
    [ -L "$APP_DIR/config/baidupcs" ] && rm -f "$APP_DIR/config/baidupcs" 2>/dev/null
    return 0
}

# ---------- config ----------
toml_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# filesystem.allowed_paths 是上游的“目录白名单”，非空时选择器无法进入白名单以外的
# 任何路径（实测会报“路径不在允许访问的范围内: /vol1”）。fnOS 的存储卷自带 ACL，
# 真正的读写权限由系统裁决，因此这里保持为空（=不限制），否则用户无法选择下载目录。
# 用户授权目录仍然会被记录，供状态展示与诊断使用。
build_allowed_paths() {
    printf '[]'
}

write_conf() {
    local dl allowed
    dl="$(resolve_download_dir)"
    allowed="$(build_allowed_paths "$dl")"
    mkdir -p "$ETC_DIR"
    cat > "$CONF" <<EOF
# Generated by the BaiduPCS fnOS package. Edit [server]/[download] here, or use
# the App Center settings page (which regenerates this file).

[server]
host = "0.0.0.0"
port = ${WEB_PORT}
cors_origins = ["*"]

[download]
download_dir = "$(toml_escape "$dl")"
ask_each_time = false
max_global_threads = 15
chunk_size_mb = 10
max_concurrent_tasks = 5
max_retries = 3

[filesystem]
allowed_paths = ${allowed}
default_path = "$(toml_escape "$dl")"
show_hidden = false
follow_symlinks = false

[persistence]
wal_dir = "$(toml_escape "$VAR_DIR/wal")"
db_path = "$(toml_escape "$VAR_DIR/config/baidu-pcs.db")"

[log]
log_dir = "$(toml_escape "$VAR_DIR/logs")"
level = "info"
retention_days = 7
EOF
    chmod 600 "$CONF" 2>/dev/null
    if [ "$(id -u)" -eq 0 ] && [ "${RUN_UID:-0}" -ne 0 ]; then
        chown "${RUN_UID}:${RUN_GID}" "$CONF" 2>/dev/null || true
    fi
    printf '%s' "$DATA_VERSION" > "$CONF_MARK" 2>/dev/null
    printf 'RUN_USER=%s\n' "$RUN_USER" > "$RUN_CONF" 2>/dev/null
    log "config written: ${CONF} (run user: ${RUN_USER})"
}

current_download_dir() {
    [ -f "$CONF" ] || return 0
    sed -n 's/^download_dir = "\(.*\)"$/\1/p' "$CONF" 2>/dev/null | head -n 1
}

# 只改单个键，保留用户在应用内改过的其它配置（Web 密码、线程数等）
set_download_dir() {
    local dl="$1"
    [ -n "$dl" ] || return 0
    [ -f "$CONF" ] || return 0
    local esc
    esc="$(toml_escape "$dl")"
    if grep -q '^download_dir = ' "$CONF" 2>/dev/null; then
        sed -i "s#^download_dir = .*#download_dir = \"${esc}\"#" "$CONF" 2>/dev/null || true
    fi
    if grep -q '^default_path = ' "$CONF" 2>/dev/null; then
        sed -i "s#^default_path = .*#default_path = \"${esc}\"#" "$CONF" 2>/dev/null || true
    fi
    log "download_dir updated: ${dl}"
}

resolve_download_dir() {
    if [ -n "$DOWNLOAD_DIR" ]; then
        printf '%s' "$DOWNLOAD_DIR"
    else
        printf '%s' "$(share_root)"
    fi
}

# Keep a config the user edited by hand, but refresh the runtime paths when the
# app version that generated it changes (paths may move between releases).
sync_conf_paths() {
    [ -f "$CONF" ] || return 0
    sed -i \
        -e "s#^wal_dir = .*#wal_dir = \"$(toml_escape "$VAR_DIR/wal")\"#" \
        -e "s#^db_path = .*#db_path = \"$(toml_escape "$VAR_DIR/config/baidu-pcs.db")\"#" \
        -e "s#^log_dir = .*#log_dir = \"$(toml_escape "$VAR_DIR/logs")\"#" \
        "$CONF" 2>/dev/null || true
    [ -f "$RUN_CONF" ] || printf 'RUN_USER=%s\n' "$RUN_USER" > "$RUN_CONF" 2>/dev/null
    # v1 把 allowed_paths 限在白名单内，导致下载目录选择器无法浏览；升级时放行。
    if [ "$(cat "$CONF_MARK" 2>/dev/null)" != "$DATA_VERSION" ]; then
        sed -i 's#^allowed_paths = .*#allowed_paths = []#' "$CONF" 2>/dev/null || true
        printf '%s' "$DATA_VERSION" > "$CONF_MARK" 2>/dev/null
        log "migrated config to schema ${DATA_VERSION} (allowed_paths unrestricted)"
    fi
}

# ---------- process ----------
is_running() {
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid="$(head -n 1 "$PID_FILE" 2>/dev/null | tr -d '[:space:]')"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || { rm -f "$PID_FILE"; return 1; }
    return 0
}

port_in_use() {
    command -v ss >/dev/null 2>&1 || return 1
    ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${1}$"
}

start_app() {
    if is_running; then
        log "already running"
        return 0
    fi
    if port_in_use "$WEB_PORT"; then
        local who
        who="$(ss -ltnp 2>/dev/null | awk -v p=":${WEB_PORT}" '$4 ~ p"$"' | head -n 1)"
        fail "端口 ${WEB_PORT} 已被其他程序占用：${who:-未知进程}。请先停止该程序后再启动本应用。"
    fi
    [ -x "$BIN" ] || fail "主程序缺失或不可执行：${BIN}（请重新安装应用包）"
    # run.conf holds what the settings page collected, so a restart keeps the
    # chosen user instead of falling back to the built-in default.
    if [ -f "$RUN_CONF" ]; then
        # shellcheck disable=SC1090
        . "$RUN_CONF" 2>/dev/null || true
    fi
    merge_wizard
    resolve_identity
    ensure_dirs
    # first start creates the config; afterwards the user's own edits win
    if [ -f "$CONF" ]; then
        sync_conf_paths
    else
        write_conf
    fi
    link_paths
    chmod 755 "$BIN" 2>/dev/null || true

    local home
    home="$(getent passwd "$RUN_USER" 2>/dev/null | cut -d: -f6)"
    [ -n "$home" ] && [ -d "$home" ] || home="$VAR_DIR"

    log "starting BaiduPCS as ${RUN_USER} (${RUN_UID}:${RUN_GID}), port ${WEB_PORT}"
    (
        cd "$RUNDIR" || exit 1
        export HOME="$home"
        export TZ="${TZ:-$(cat /etc/timezone 2>/dev/null || echo Asia/Shanghai)}"
        export RUST_LOG="${RUST_LOG:-info}"
        if [ "$(id -u)" -eq 0 ] && [ "${RUN_UID:-0}" -ne 0 ]; then
            if command -v setpriv >/dev/null 2>&1; then
                exec setpriv --reuid "$RUN_UID" --regid "$RUN_GID" --init-groups -- "$BIN"
            fi
            exec runuser -u "$RUN_USER" -- "$BIN"
        fi
        exec "$BIN"
    ) >> "$LOG" 2>&1 &
    echo "$!" > "$PID_FILE"

    log "started pid=$(cat "$PID_FILE" 2>/dev/null)"
    return 0
}

stop_app() {
    if [ ! -f "$PID_FILE" ]; then
        return 0
    fi
    local pid i=0
    pid="$(head -n 1 "$PID_FILE" 2>/dev/null | tr -d '[:space:]')"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        log "stopping pid=${pid}"
        kill -TERM "$pid" 2>/dev/null || true
        while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 20 ]; do
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            log "force kill pid=${pid}"
            kill -KILL "$pid" 2>/dev/null || true
            sleep 1
        fi
    fi
    rm -f "$PID_FILE"
    return 0
}

# 收集所有相关的卷根（/vol1、/vol2…）：@appconf / @appdata / @apptemp / 安装目录
# 可能落在不同卷上，逐个处理才不会漏。
volume_roots() {
    local p real root
    for p in "$ETC_DIR" "$VAR_DIR" "$TMP_DIR" "$APP_DIR"; do
        # 目录可能已被 fnOS 删除，readlink -f 会返回空；退回单层 readlink，再退回字面路径
        real="$(readlink -f "$p" 2>/dev/null)"
        [ -n "$real" ] || real="$(readlink "$p" 2>/dev/null)"
        [ -n "$real" ] || real="$p"
        case "$real" in
            /vol[0-9]*/@app*/*) root="$(printf '%s' "$real" | sed -n 's#^\(/vol[0-9]*\)/.*#\1#p')" ;;
            /vol[0-9]*/*)       root="$(printf '%s' "$real" | sed -n 's#^\(/vol[0-9]*\)/.*#\1#p')" ;;
            *) continue ;;
        esac
        [ -n "$root" ] && printf '%s\n' "$root"
    done | sort -u
}

# 彻底清理：@appconf / @appdata / @apphome / @apptemp / @appmeta / @appcenter，
# 外加共享目录（仅当已无用户文件）与应用专用系统账号。
# 卸载回调执行时 fnOS 可能已删掉部分目录，因此每一步都允许"不存在"。
PURGE_LOG="/tmp/baidupcs-uninstall.log"

purge_note() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> "$PURGE_LOG" 2>/dev/null; }

# 需要清理的卷根：先由 TRIM_* 推导，再用 /vol* 全量兜底（目录被提前删除时推导会失效）
purge_roots() {
    local app="$1" v roots=""
    roots="$(volume_roots)"
    for v in /vol[0-9]*; do
        [ -d "$v" ] || continue
        if [ -e "$v/@appshare/$app" ] || [ -e "$v/@appconf/$app" ] || [ -e "$v/@appdata/$app" ] \
           || [ -e "$v/@apphome/$app" ] || [ -e "$v/@appmeta/$app" ] || [ -e "$v/@apptemp/$app" ] \
           || [ -e "$v/@appcenter/$app" ]; then
            roots="${roots}
${v}"
        fi
    done
    printf '%s\n' "$roots" | sed '/^$/d' | sort -u
}

purge_app_data() {
    local app="$1" root kind dir left="" share
    : > "$PURGE_LOG" 2>/dev/null
    purge_note "purge start for ${app}"

    # 1) fnOS 托管目录
    while read -r root; do
        [ -n "$root" ] || continue
        for kind in @appcenter @appconf @appdata @apphome @appmeta @apptemp @apptmp; do
            dir="${root}/${kind}/${app}"
            if [ -e "$dir" ] || [ -L "$dir" ]; then
                purge_note "remove ${dir}"
                chattr -R -i "$dir" >/dev/null 2>&1 || true
                rm -rf "$dir" 2>/dev/null || true
            fi
        done

        # 2) 共享目录：只为空才删，绝不碰用户已下载的文件
        share="${root}/@appshare/${app}"
        if [ -d "$share" ]; then
            # 只有空目录、没有任何文件/软链时才算“可清理”，避免误删用户下载的内容
            if [ -z "$(find "$share" \( -type f -o -type l \) 2>/dev/null | head -n 1)" ]; then
                purge_note "remove empty share ${share}"
                rm -rf "$share" 2>/dev/null || true
            else
                purge_note "keep ${share} (contains user files)"
            fi
        fi
    done <<EOF2
$(purge_roots "$app")
EOF2

    # 3) 安装目录里的残留软链
    for kind in etc var tmp home meta target; do
        [ -L "/var/apps/${app}/${kind}" ] && rm -f "/var/apps/${app}/${kind}" 2>/dev/null
    done

    # 4) 应用专用系统账号（fnOS 一般会自动回收，这里兜底）
    if id -u "$app" >/dev/null 2>&1; then
        purge_note "remove system user ${app}"
        userdel "$app" >/dev/null 2>&1 || true
    fi
    if getent group "$app" >/dev/null 2>&1; then
        purge_note "remove system group ${app}"
        groupdel "$app" >/dev/null 2>&1 || true
    fi

    # 5) 校验结果并回报给卸载界面
    while read -r root; do
        [ -n "$root" ] || continue
        for kind in @appcenter @appconf @appdata @apphome @appmeta @apptemp @apptmp; do
            [ -e "${root}/${kind}/${app}" ] && left="${left} ${root}/${kind}/${app}"
        done
        [ -e "${root}/@appshare/${app}" ] && left="${left} ${root}/@appshare/${app}"
    done <<EOF3
$(purge_roots "$app")
EOF3
    id -u "$app" >/dev/null 2>&1 && left="${left} user:${app}"

    if [ -n "$left" ]; then
        purge_note "remaining:${left}"
        echo "部分配置未能删除，仍存在：${left}。详见 ${PURGE_LOG}" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}" 2>/dev/null || true
    else
        purge_note "purge complete"
    fi
    LOG=/dev/null
}

case "${1:-status}" in
    start)
        start_app
        ;;
    stop)
        stop_app
        ;;
    restart)
        stop_app
        start_app
        ;;
    status)
        if is_running; then
            exit 0
        fi
        exit 3
        ;;
    install_init|upgrade_init|uninstall_init|config_init)
        exit 0
        ;;
    install_callback|upgrade_callback)
        merge_wizard
        resolve_identity
        ensure_dirs
        if [ -f "$CONF" ]; then
            sync_conf_paths
        else
            write_conf
        fi
        link_paths
        exit 0
        ;;
    config_callback)
        merge_wizard
        # 设置页留空表示“保持当前值”，只有填了才改
        [ -z "$DOWNLOAD_DIR" ] && DOWNLOAD_DIR="$(current_download_dir)"
        resolve_identity
        ensure_dirs
        set_download_dir "$DOWNLOAD_DIR"
        sync_conf_paths
        printf 'RUN_USER=%s\n' "$RUN_USER" > "$RUN_CONF" 2>/dev/null
        link_paths
        stop_app
        start_app
        exit 0
        ;;
    uninstall_callback)
        stop_app
        case "${wizard_data_action:-keep}" in
            purge)
                purge_app_data "$APPNAME"
                ;;
            *)
                log "uninstall: keeping configuration and data"
                ;;
        esac
        exit 0
        ;;
    *)
        echo "usage: $0 {start|stop|restart|status}" >&2
        exit 1
        ;;
esac
